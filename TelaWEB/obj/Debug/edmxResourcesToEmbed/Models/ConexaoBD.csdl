    <Property Name="definition" Type="Binary" MaxLength="Max" FixedLength="false" />
  </EntityType>
  <Association Name="FK_Celular_Pessoa">
    <End Role="Pessoa" Type="Self.Pessoa" Multiplicity="1" />

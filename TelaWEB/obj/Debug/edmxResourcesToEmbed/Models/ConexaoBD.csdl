  </Association>
  <EntityContainer Name="BDTCCEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="Celular" EntityType="Self.Celular" />
    <EntitySet Name="Endereco" EntityType="Self.Endereco" />

@model IEnumerable<TelaWEB.Models.Celular>


@{
    ViewBag.Title = "TelaPropostaFisica";
}

<h2>Tela Proposta Fisica</h2>

@foreach (var item in Model)
{
    <div class="Table_propostaF">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Celular</th>
                    <th scope="col">Empresa</th>
                    <th scope="col">Valor</th>
                    <th scope="col">date</th>
                    <th scope="col">Horario</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@item.modelo</td>
                    <td><button type="button" class="btn btn-success">Aceitar</button></td>
                    <td><button type="button" class="btn btn-danger">Negar</button></td>

                </tr>
            </tbody>
        </table>


    </div>
}